+# ---------------------------------------------------------------------------
+# activity_summary / daily_timeseries: previously untested. These also pin
+# down the fix that made outcome-filtering consistent between the two (both
+# now use _ATTEMPTED_OUTCOMES, excluding no_keys/upstream_exhausted from
+# totals) so their numbers agree for the same range.
+#
+# activity_summary's SQL uses percentile_cont(...).within_group(...), which
+# is real PostgreSQL "ordered-set aggregate" syntax with no SQLite
+# equivalent (confirmed: SQLite's parser rejects `WITHIN GROUP` outright, so
+# there's no UDF trick that fixes it — unlike date_trunc, which conftest.py
+# does shim). These are marked xfail against the sqlite-backed db_session
+# fixture rather than silently skipped, so a switch to a real Postgres test
+# DB (e.g. testcontainers) will surface as a visible "unexpectedly passed"
+# rather than staying invisible.
+# ---------------------------------------------------------------------------
+
+_PERCENTILE_CONT_NOT_ON_SQLITE = pytest.mark.xfail(
+    reason="percentile_cont(...).within_group(...) is PostgreSQL-only syntax; "
+    "the sqlite test DB used by db_session cannot run it. Needs a real "
+    "Postgres test database to exercise this path.",
+    raises=Exception,
+    strict=False,
+)
+
+
+@_PERCENTILE_CONT_NOT_ON_SQLITE
+@pytest.mark.asyncio
+async def test_activity_summary_splits_current_and_previous_window(db_session: AsyncSession):
+    publisher = RequestEventPublisher(session=db_session)
+    now = datetime.now(UTC)
+
+    await _seed(
+        db_session,
+        # Current 7d window: 2 success, 1 rate_limited.
+        _event(
+            request_id="curr-1",
+            outcome="success",
+            timestamp=now - timedelta(days=1),
+            total_tokens=100,
+            latency_ms=100,
+        ),
+        _event(
+            request_id="curr-2",
+            outcome="success",
+            timestamp=now - timedelta(days=2),
+            total_tokens=50,
+            latency_ms=200,
+        ),
+        _event(
+            request_id="curr-3",
+            outcome="rate_limited",
+            timestamp=now - timedelta(days=3),
+            latency_ms=300,
+        ),
+        # Previous 7-14d window: 1 success only.
+        _event(
+            request_id="prev-1",
+            outcome="success",
+            timestamp=now - timedelta(days=9),
+            total_tokens=40,
+            latency_ms=150,
+        ),
+    )
+
+    summary = await publisher.activity_summary(1, "7d")
+
+    assert summary.total_requests == 3
+    assert summary.prev_total_requests == 1
+    assert summary.success_rate == round(100 * 2 / 3, 1)
+    assert summary.prev_success_rate == 100.0
+    assert summary.total_tokens == 150
+    assert summary.prev_total_tokens == 40
+
