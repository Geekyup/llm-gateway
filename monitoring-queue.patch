+async def _seed(db_session: AsyncSession, *events: RequestEvent) -> None:
+    """Insert events directly into request_events, bypassing the Redis queue.
+
+    Read-side aggregation tests (hourly usage, activity_summary, activity_log,
+    ...) care about SQL query correctness against rows that are already
+    persisted — they shouldn't also depend on the publish()/drain_event_queue()
+    producer-consumer path working. That path has its own dedicated tests
+    below (see the "queue" section).
+    """
+    for event in events:
+        db_session.add(
+            RequestEventRecord(
+                user_id=event.user_id,
+                key_id=event.key_id,
+                request_id=event.request_id,
+                attempt=event.attempt,
+                timestamp=event.timestamp,
+                provider=event.provider,
+                path=event.path,
+                method=event.method,
+                key_label=event.key_label,
+                model=event.model,
+                upstream_status=event.upstream_status,
+                outcome=event.outcome,
+                latency_ms=event.latency_ms,
+                is_retry=event.is_retry,
+                error_detail=event.error_detail,
+                prompt_tokens=event.prompt_tokens,
+                completion_tokens=event.completion_tokens,
+                total_tokens=event.total_tokens,
+            )
+        )
+    await db_session.commit()
+
+
