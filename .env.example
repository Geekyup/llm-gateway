# Copy to .env and fill in real values. Never commit the real .env.

APP_NAME=llm-gateway
ENV=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://llm_gateway:llm_gateway@postgres:5432/llm_gateway
DB_ECHO=false

REDIS_URL=redis://redis:6379/0

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_ME_WITH_GENERATED_FERNET_KEY

# Any long random string — bearer token for /admin/* endpoints.
ADMIN_API_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

KEY_STATUS_CACHE_TTL_SECONDS=30
GATEWAY_MAX_RETRY_ATTEMPTS=3
DEFAULT_DAILY_LIMIT=1000

GEMINI_BASE_URL=https://generativelanguage.googleapis.com
UPSTREAM_TIMEOUT_SECONDS=60
