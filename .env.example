APP_NAME=llm-gateway
ENV=local
DEBUG=true

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

DATABASE_URL=postgresql+asyncpg://llm_gateway:llm_gateway@postgres:5432/llm_gateway
DB_ECHO=false

REDIS_URL=redis://redis:6379/0

ENCRYPTION_KEY=REPLACE_ME_WITH_GENERATED_FERNET_KEY

ADMIN_API_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

JWT_SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

SESSION_SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

KEY_STATUS_CACHE_TTL_SECONDS=30
GATEWAY_MAX_RETRY_ATTEMPTS=3
DEFAULT_DAILY_LIMIT=1000
HOUSEKEEPING_RESET_CRON_MINUTE=0

UPSTREAM_TIMEOUT_SECONDS=60

GEMINI_BASE_URL=https://generativelanguage.googleapis.com
DEFAULT_GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_BASE_URL=https://openrouter.ai/api
DEFAULT_OPENROUTER_MODEL=google/gemini-2.0-flash-001

GROQ_BASE_URL=https://api.groq.com/openai
DEFAULT_GROQ_MODEL=llama-3.1-8b-instant
